---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = 'https://waterdamagerestorationellicottcitymd.us/og-default.jpg',
} = Astro.props;

const siteName = 'Water Damage Restoration Ellicott City MD';
const phone = '(410) 555-0199'; // Placeholder - replace with real number
const phoneLink = 'tel:+14105550199';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <header class="bg-white border-b border-neutral-200 sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-2 font-bold text-primary text-lg">
            <svg class="w-8 h-8 text-primary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
            </svg>
            <span class="hidden sm:inline">Water Damage Restoration<br class="sm:hidden" /> Ellicott City MD</span>
            <span class="sm:hidden">WDR Ellicott City</span>
          </a>
          
          <nav class="hidden lg:flex items-center gap-6" aria-label="Main navigation">
            <a href="/" class="text-neutral-700 hover:text-primary font-medium">Home</a>
            <div class="relative group">
              <button class="text-neutral-700 hover:text-primary font-medium flex items-center gap-1" aria-expanded="false" aria-haspopup="true">
                Services
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="absolute left-0 mt-2 w-72 bg-white border border-neutral-200 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="py-2 max-h-96 overflow-y-auto">
                  <a href="/services" class="block px-4 py-2 text-sm font-semibold text-primary hover:bg-neutral-50">All Services</a>
                  <a href="/services/water-damage-restoration" class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-50">Water Damage Restoration</a>
                  <a href="/services/flood-damage-cleanup" class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-50">Flood Damage Cleanup</a>
                  <a href="/services/sewage-cleanup" class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-50">Sewage Cleanup</a>
                  <a href="/services/mold-remediation" class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-50">Mold Remediation</a>
                  <a href="/services/basement-water-removal" class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-50">Basement Water Removal</a>
                  <a href="/services/emergency-water-extraction" class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-50">Emergency Water Extraction</a>
                  <a href="/services" class="block px-4 py-2 text-sm text-accent font-medium hover:bg-neutral-50">View all 20 services →</a>
                </div>
              </div>
            </div>
            <a href="/service-areas" class="text-neutral-700 hover:text-primary font-medium">Service Areas</a>
            <a href="/about" class="text-neutral-700 hover:text-primary font-medium">About</a>
            <a href="/blog" class="text-neutral-700 hover:text-primary font-medium">Blog</a>
            <a href="/contact" class="text-neutral-700 hover:text-primary font-medium">Contact</a>
          </nav>
          
          <div class="flex items-center gap-3">
            <a href={phoneLink} class="hidden sm:inline-flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-lg font-semibold hover:bg-primary-dark transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {phone}
            </a>
            <button id="mobile-menu-btn" class="lg:hidden p-2 text-neutral-700" aria-label="Open menu" aria-expanded="false">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
          </div>
        </div>
      </div>
      
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-200 bg-white">
        <nav class="px-4 py-4 space-y-2" aria-label="Mobile navigation">
          <a href="/" class="block py-2 text-neutral-700 font-medium">Home</a>
          <a href="/services" class="block py-2 text-neutral-700 font-medium">Services</a>
          <a href="/service-areas" class="block py-2 text-neutral-700 font-medium">Service Areas</a>
          <a href="/about" class="block py-2 text-neutral-700 font-medium">About</a>
          <a href="/blog" class="block py-2 text-neutral-700 font-medium">Blog</a>
          <a href="/contact" class="block py-2 text-neutral-700 font-medium">Contact</a>
          <a href={phoneLink} class="block py-3 mt-2 bg-primary text-white text-center rounded-lg font-semibold">{phone}</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="bg-neutral-900 text-neutral-200 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div>
            <h3 class="text-white font-bold text-lg mb-4">Water Damage Restoration Ellicott City MD</h3>
            <p class="text-sm leading-relaxed">Professional water damage restoration services serving Ellicott City, Westminster, and surrounding Maryland communities. Fast response when you need it most.</p>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4">Quick Links</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/services" class="hover:text-accent-light">Services</a></li>
              <li><a href="/service-areas" class="hover:text-accent-light">Service Areas</a></li>
              <li><a href="/about" class="hover:text-accent-light">About Us</a></li>
              <li><a href="/blog" class="hover:text-accent-light">Blog</a></li>
              <li><a href="/contact" class="hover:text-accent-light">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4">Popular Services</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/services/water-damage-restoration" class="hover:text-accent-light">Water Damage Restoration</a></li>
              <li><a href="/services/flood-damage-cleanup" class="hover:text-accent-light">Flood Damage Cleanup</a></li>
              <li><a href="/services/mold-remediation" class="hover:text-accent-light">Mold Remediation</a></li>
              <li><a href="/services/emergency-water-extraction" class="hover:text-accent-light">Emergency Extraction</a></li>
              <li><a href="/services/basement-water-removal" class="hover:text-accent-light">Basement Water Removal</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-4">Contact</h4>
            <ul class="space-y-2 text-sm">
              <li>
                <a href={phoneLink} class="hover:text-accent-light flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  {phone}
                </a>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span>4145 Ridge Rd<br>Westminster, MD 21157</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="border-t border-neutral-700 mt-8 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm">
          <p>&copy; {new Date().getFullYear()} Water Damage Restoration Ellicott City MD. All rights reserved.</p>
          <div class="flex gap-4">
            <a href="/privacy" class="hover:text-accent-light">Privacy Policy</a>
            <a href="/terms" class="hover:text-accent-light">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Sticky mobile click-to-call -->
    <div class="mobile-cta">
      <a href={phoneLink} class="flex items-center justify-center gap-2 bg-primary text-white py-4 font-bold text-lg w-full">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call Now: {phone}
      </a>
    </div>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
