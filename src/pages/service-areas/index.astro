---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { areas } from '../../data/areas';

const title = 'Service Areas | Water Damage Restoration Near Ellicott City MD';
const description = 'We provide water damage restoration services in Ellicott City, Westminster, Columbia, Catonsville, Laurel and nearby Maryland communities.';
---

<BaseLayout title={title} description={description}>
  <section class="bg-primary text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Areas We Serve</h1>
      <p class="text-sky-100 text-lg max-w-3xl">Local water damage restoration for Ellicott City, Westminster, and neighboring communities across central Maryland.</p>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {areas.map((area) => (
          <a href={`/service-areas/${area.slug}`} class="block p-6 bg-white border border-neutral-200 rounded-xl hover:border-primary hover:shadow-md transition-all">
            <h2 class="text-xl font-semibold text-neutral-900 mb-2">{area.name}</h2>
            <p class="text-neutral-600 text-sm leading-relaxed line-clamp-3">{area.description}</p>
            <span class="inline-block mt-3 text-primary text-sm font-medium">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 bg-neutral-50">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-neutral-900 mb-4">Don't See Your Town?</h2>
      <p class="text-neutral-600 mb-6">We regularly serve additional communities in Howard, Carroll, and nearby counties. Call to confirm availability for your address.</p>
      <a href="tel:+14105550199" class="inline-flex items-center justify-center gap-2 bg-primary text-white font-semibold px-6 py-3 rounded-lg hover:bg-primary-dark transition-colors">Call (410) 555-0199</a>
    </div>
  </section>
</BaseLayout>
