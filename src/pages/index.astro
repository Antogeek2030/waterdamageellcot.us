---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { areas } from '../data/areas';

const title = 'Water Damage Restoration in Ellicott City MD | Fast Local Service';
const description = 'Professional water damage restoration serving Ellicott City, Westminster, Columbia and nearby MD communities. Emergency extraction, drying, mold prevention. Call now.';
const phone = '(410) 555-0199';
const phoneLink = 'tel:+14105550199';
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary-dark text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight mb-6">
          Water Damage Restoration in Ellicott City, MD
        </h1>
        <p class="text-lg sm:text-xl text-sky-100 mb-8 leading-relaxed">
          Fast, professional response when water threatens your home or business. Extraction, structural drying, and complete restoration for Ellicott City, Westminster, and surrounding communities.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={phoneLink} class="inline-flex items-center justify-center gap-2 bg-white text-primary font-bold px-8 py-4 rounded-lg text-lg hover:bg-sky-50 transition-colors shadow-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call {phone}
          </a>
          <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-semibold px-8 py-4 rounded-lg text-lg hover:bg-white/10 transition-colors">
            Request a Callback
          </a>
        </div>
        <p class="mt-6 text-sky-200 text-sm">Available for emergency calls • Serving Howard & Carroll Counties</p>
      </div>
    </div>
  </section>

  <!-- Trust / Why Us -->
  <section class="py-16 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-neutral-900 mb-12">Why Property Owners Choose Us</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-neutral-100">
          <div class="w-12 h-12 bg-sky-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Rapid Local Response</h3>
          <p class="text-neutral-600 leading-relaxed">We prioritize calls from the Ellicott City and Westminster area so help can arrive while it still matters most.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-neutral-100">
          <div class="w-12 h-12 bg-sky-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Thorough, Documented Work</h3>
          <p class="text-neutral-600 leading-relaxed">Moisture readings, clear communication, and careful drying help protect your property and support insurance processes.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-neutral-100">
          <div class="w-12 h-12 bg-sky-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Respectful Service</h3>
          <p class="text-neutral-600 leading-relaxed">We treat your home or business with care, keep you informed, and work efficiently so you can return to normal sooner.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-4">Our Water Damage Services</h2>
        <p class="text-neutral-600 max-w-2xl mx-auto">From emergency extraction to complete restoration and mold prevention, we offer a full range of services tailored to residential and commercial properties.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.slice(0, 9).map((service) => (
          <a href={`/services/${service.slug}`} class="group block bg-white border border-neutral-200 rounded-xl p-6 hover:border-primary hover:shadow-md transition-all">
            <h3 class="text-lg font-semibold text-neutral-900 group-hover:text-primary mb-2">{service.title}</h3>
            <p class="text-neutral-600 text-sm leading-relaxed">{service.shortDesc}</p>
            <span class="inline-block mt-3 text-primary text-sm font-medium group-hover:underline">Learn more →</span>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/services" class="inline-flex items-center gap-2 text-primary font-semibold hover:underline">
          View all 20 services
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-4">Areas We Serve</h2>
        <p class="text-neutral-600 max-w-2xl mx-auto">Proudly serving Ellicott City, Westminster, and neighboring communities across Howard, Carroll, and nearby counties.</p>
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        {areas.map((area) => (
          <a href={`/service-areas/${area.slug}`} class="px-5 py-2.5 bg-white border border-neutral-200 rounded-full text-neutral-700 font-medium hover:border-primary hover:text-primary transition-colors">
            {area.name}
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/service-areas" class="text-primary font-semibold hover:underline">See all service areas →</a>
      </div>
    </div>
  </section>

  <!-- Reviews placeholder (honest) -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-neutral-900 mb-4">What Local Property Owners Say</h2>
      <p class="text-center text-neutral-600 mb-12 max-w-2xl mx-auto">We earn trust through reliable work and clear communication. Here is the kind of feedback we aim to deserve on every job.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <blockquote class="bg-neutral-50 p-6 rounded-xl border border-neutral-100">
          <p class="text-neutral-700 leading-relaxed mb-4">“They arrived quickly after our basement flooded and kept us informed the whole time. The drying process was thorough and the crew was respectful of our home.”</p>
          <footer class="text-sm text-neutral-500">— Homeowner, Ellicott City area</footer>
        </blockquote>
        <blockquote class="bg-neutral-50 p-6 rounded-xl border border-neutral-100">
          <p class="text-neutral-700 leading-relaxed mb-4">“Professional from the first call through final walkthrough. They documented everything clearly for our insurance and the results spoke for themselves.”</p>
          <footer class="text-sm text-neutral-500">— Property manager, nearby community</footer>
        </blockquote>
        <blockquote class="bg-neutral-50 p-6 rounded-xl border border-neutral-100">
          <p class="text-neutral-700 leading-relaxed mb-4">“A pipe burst while we were away. Their emergency response limited the damage significantly. Grateful for the fast help.”</p>
          <footer class="text-sm text-neutral-500">— Resident, Westminster area</footer>
        </blockquote>
      </div>
      <p class="text-center text-sm text-neutral-500 mt-8">These examples reflect the standard of service we strive to deliver. Individual experiences vary.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4">Need Help With Water Damage?</h2>
      <p class="text-sky-100 text-lg mb-8">Whether it is a small leak or a major flood, we are ready to help protect your property. Call now for a prompt response.</p>
      <a href={phoneLink} class="inline-flex items-center gap-2 bg-white text-primary font-bold px-8 py-4 rounded-lg text-lg hover:bg-sky-50 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call {phone}
      </a>
    </div>
  </section>
</BaseLayout>
