---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Terms of Service | Water Damage Restoration Ellicott City MD';
const description = 'Terms of service for waterdamagerestorationellicottcitymd.us governing use of our website and information presented.';
---

<BaseLayout title={title} description={description}>
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-neutral-900 mb-8">Terms of Service</h1>
      <div class="space-y-6 text-neutral-700 leading-relaxed">
        <p>Last updated: November 2025</p>
        <p>By accessing waterdamagerestorationellicottcitymd.us, you agree to these terms of service. If you do not agree, please do not use the site.</p>
        
        <h2 class="text-xl font-bold text-neutral-900">Website Content</h2>
        <p>The information on this website is provided for general informational purposes. It does not constitute a binding offer, professional advice specific to your situation, or a guarantee of service availability or pricing. Actual service details, pricing, and availability are confirmed through direct communication.</p>
        
        <h2 class="text-xl font-bold text-neutral-900">Service Requests</h2>
        <p>Submitting a contact form or calling does not create a contract for services. A formal agreement is formed only when both parties agree to specific work, pricing, and terms.</p>
        
        <h2 class="text-xl font-bold text-neutral-900">No Warranties</h2>
        <p>This website is provided “as is.” We make no warranties regarding the accuracy, completeness, or availability of the site or its content.</p>
        
        <h2 class="text-xl font-bold text-neutral-900">Limitation of Liability</h2>
        <p>To the fullest extent permitted by law, we are not liable for any indirect, incidental, or consequential damages arising from your use of the website.</p>
        
